# MedGuard AI - Environment Configuration

# Service Environment: 'development' | 'staging' | 'production'
ENVIRONMENT=development
LOG_LEVEL=INFO

# Security & HIPAA / GDPR Compliance
SECRET_KEY=clinical_decision_support_secure_key_change_in_production_32chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
AUDIT_LOG_STORAGE_PATH=./data/audit_logs/hipaa_audit.jsonl
ENABLE_PHI_SCRUBBING=true
ANONYMIZE_IP_ADDRESSES=true

# Database Persistence
# For Docker deployment: postgresql+asyncpg://medguard_user:medguard_secret@postgres:5432/medguard_db
# For local zero-dependency fallback: sqlite+aiosqlite:///./medguard_clinical.db
DATABASE_URL=sqlite+aiosqlite:///./medguard_clinical.db
POSTGRES_USER=medguard_user
POSTGRES_PASSWORD=medguard_secret
POSTGRES_DB=medguard_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Vector Store & Clinical RAG Engine
VECTOR_STORE_PATH=./data/vector_store
VECTOR_SIMILARITY_THRESHOLD=0.62
MAX_RETRIEVED_CHUNKS=4

# Emergency Red-Flag Triage
EMERGENCY_ESCALATION_HOTLINE_US=911
EMERGENCY_ESCALATION_HOTLINE_UK=999
EMERGENCY_ESCALATION_HOTLINE_EU=112
EMERGENCY_ESCALATION_HOTLINE_LK=1990
SUICIDE_CRISIS_LIFELINE=988
SUICIDE_CRISIS_LIFELINE_LK=1926

# Hybrid Cloud LLM Integration (Optional - Falls back to 100% Local Deterministic Engine if unset)
# LLM_PROVIDER options: 'auto' | 'gemini' | 'anthropic' | 'openai' | 'local'
LLM_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=900
LLM_TIMEOUT_SECONDS=12.0

# Application Endpoints
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
